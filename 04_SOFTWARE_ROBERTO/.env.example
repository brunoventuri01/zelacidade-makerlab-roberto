# Copie este arquivo para .env e preencha os valores.
#   cp .env.example .env
# O .env está no .gitignore — NUNCA suba a sua chave para o GitHub.

# --- IA generativa (item 9) ------------------------------------------------
OPENAI_API_KEY=
LLM_BACKEND=ollama
OLLAMA_URL=http://127.0.0.1:11435
OLLAMA_MODEL=gemma3:4b

# NÃO hardcode o modelo no código. Confira no dashboard da sua conta quais
# modelos estão ativos — modelos são depreciados com data marcada.
# Qualquer modelo da faixa "mini/nano" resolve; o consumo aqui é irrisório.
OPENAI_MODEL=gpt-4.1-mini

# --- Assistente ------------------------------------------------------------
WAKE_WORD=roberto
# Como o SEU microfone transcreve o nome. Descubra rodando:
#   python tools/testar_wake.py
# Ex.: WAKE_WORD_VARIANTES=roberto,next us,nexo
WAKE_WORD_VARIANTES=

# Backend de reconhecimento de fala: google (grátis, sem chave) ou whisper (API)
STT_BACKEND=local
IDIOMA_STT=pt-BR

# --- Reconhecimento facial (item 7) ----------------------------------------
# LBPH: a "confidence" é uma DISTÂNCIA — MENOR é MELHOR.
# Abaixo do limiar = pessoa reconhecida. Suba para 80 se ele não te reconhecer,
# desça para 55 se ele confundir você com outra pessoa.
LIMIAR_FACE=70
INDICE_CAMERA=0

# --- Voz da assistente (TTS) -----------------------------------------------
# openai  = voz neural, natural, mas depende de rede (recomendado)
# pyttsx3 = voz do sistema, robótica, porém offline e instantânea
TTS_BACKEND=piper
TTS_MODELO=gpt-4o-mini-tts
# Vozes: nova, coral, shimmer, sage, alloy, fable, onyx, ash, echo, ballad
TTS_VOZ=nova
TTS_VELOCIDADE=180
# Opcional: instruções de tom para a voz neural (deixe vazio para o padrão)
TTS_INSTRUCOES=

# --- Comandos extras -------------------------------------------------------
CIDADE_PADRAO=São Paulo
